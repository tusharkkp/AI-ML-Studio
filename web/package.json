{
  "name": "aiml-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engines": "vitest run src/engines",
    "test:components": "vitest run src/components src/features",
    "e2e": "playwright test",
    "e2e:shots": "playwright test --project=shots",
    "check:content": "tsx ../tools/check-content.ts",
    "check:links": "tsx ../tools/check-links.ts",
    "check:coverage": "tsx ../tools/check-coverage.ts",
    "check:originality": "tsx ../tools/check-originality.ts",
    "check:engine-ids": "tsx ../tools/check-engine-ids.ts",
    "check:a11y": "playwright test --project=a11y",
    "check:bundle": "tsx ../tools/check-bundle.ts",
    "verify:fast": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "verify:content": "npm run check:content && npm run check:links && npm run check:engine-ids && npm run check:originality && npm run check:coverage",
    "verify:phase": "npm run verify:fast && npm run build && npm run test:engines"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mdx-js/rollup": "^3.1.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fast-check": "^3.23.2",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
